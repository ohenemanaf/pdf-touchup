/* PDF Touch-up: compact, neutral, one accent (#2F6FEB). */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
    color: #1f2329;
}
QMainWindow, QWidget#body { background: #ffffff; }

QToolBar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    padding: 6px 10px;
    spacing: 4px;
}
QToolBar QToolButton {
    min-height: 30px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
}
QToolBar QToolButton:hover { background: #f1f3f6; }
QToolBar QToolButton:pressed { background: #e6e9ee; }
QToolBar QToolButton:disabled { color: #a3a9b2; }
QLabel#pageLabel, QLabel#zoomLabel { color: #5b6470; padding: 0 8px; }

QListWidget#thumbs {
    background: #f7f8fa;
    border: none;
    border-right: 1px solid #e3e6ea;
    padding: 8px 6px;
    outline: none;
}
QListWidget#thumbs::item {
    border-radius: 8px;
    padding: 6px 4px;
    margin-bottom: 4px;
    color: #5b6470;
}
QListWidget#thumbs::item:selected { background: #e8effd; color: #2f6feb; }
QListWidget#thumbs::item:hover:!selected { background: #eef0f3; }

QGraphicsView { border: none; }

QLabel#busyChip {
    background: #1f2329;
    color: #ffffff;
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 13px;
}

QStatusBar {
    background: #f7f8fa;
    border-top: 1px solid #e3e6ea;
    color: #5b6470;
    min-height: 26px;
}
QStatusBar QLabel { color: #5b6470; padding: 0 8px; font-size: 13px; }

/* Edit popover */
QFrame#editPopover {
    background: #ffffff;
    border: 1px solid #d9dde3;
    border-radius: 12px;
}
QFrame#editPopover QLabel { color: #5b6470; font-size: 13px; }
QFrame#editPopover QLabel#warning { color: #c62f2f; }
QLineEdit, QComboBox, QDoubleSpinBox {
    min-height: 32px;
    padding: 0 8px;
    border: 1px solid #d9dde3;
    border-radius: 8px;
    background: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus { border-color: #2f6feb; }
QPushButton {
    min-height: 32px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid #d9dde3;
    background: #ffffff;
}
QPushButton:hover { background: #f1f3f6; }
QPushButton#primary { background: #2f6feb; border-color: #2f6feb; color: #ffffff; }
QPushButton#primary:hover { background: #2a63d4; }
QPushButton#primary:disabled { background: #a9c1f3; border-color: #a9c1f3; }
QPushButton#swatch { min-width: 32px; max-width: 32px; padding: 0; }
